#!/bin/bash

# PHP Container Proxy Script
# This script serves as a proxy to run PHP commands through the PHP 8.3 container.
# From outside it should look like normal php executable.

# Get the directory of the script
DIR=$(dirname "$0")

# Get the root directory of the project
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CURSOR_HOME_DIR=$(realpath "${HOME}/.cursor")

# Build the docker command
DOCKER_CMD="docker run -i --rm -v ${ROOT}:${ROOT} -v ${CURSOR_HOME_DIR}:${CURSOR_HOME_DIR} -w ${ROOT} php:8.3-cli-alpine php -d memory_limit=-1 bin/phpstan"

# Execute the command with all arguments passed through
exec $DOCKER_CMD "$@"
